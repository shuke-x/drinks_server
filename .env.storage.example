# Start locally; switch to s3 only after copying and verifying existing files.
STORAGE_DRIVER=local
PUBLIC_BASE_URL=https://dash.shuke.me
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=tonight-drinks-media-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Backup tools only. Generate a 32-byte key and keep it outside this repository.
BACKUP_KEY_BASE64=
BACKUP_DIR=/secure/backups/tonight-drinks
BACKUP_WRITES_PAUSED=false
# Optional: use PostgreSQL tools inside a running database container.
PG_DOCKER_CONTAINER=
