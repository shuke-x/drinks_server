{
  "name": "drinks-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "seed": "node dist/src/seeds/cocktails.seed.js",
    "seed:dev": "ts-node -r tsconfig-paths/register src/seeds/cocktails.seed.ts",
    "migration:show": "typeorm-ts-node-commonjs -d src/config/typeorm.datasource.ts migration:show",
    "migration:run": "typeorm-ts-node-commonjs -d src/config/typeorm.datasource.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/config/typeorm.datasource.ts migration:revert",
    "migration:generate": "typeorm-ts-node-commonjs -d src/config/typeorm.datasource.ts migration:generate migrations/SchemaChange"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/typeorm": "^10.0.2",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "nanoid": "^3.3.8",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "typeorm": "^0.3.20",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "multer": "^2.2.0"
    }
  }
}
