PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DB_HOST=postgres
DB_PORT=5432
DB_USER=drinks
DB_PASS=drinks
DB_NAME=tonight_drinks
DB_SYNC=false
REDIS_HOST=redis
REDIS_PORT=6379
# Generate once with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# Store PEM on one line with literal \n characters.
AUTH_RSA_PRIVATE_KEY=
# At least 32 random bytes. Never commit a real value.
AUTH_JWT_SECRET=
AUTH_REFRESH_DAYS=30
ADMIN_BOOTSTRAP_EMAIL=
