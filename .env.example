NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true
# Nginx runs on the same host in production, so only loopback proxies are trusted.
TRUST_PROXY=loopback

DB_HOST=postgres
DB_PORT=5432
DB_USER=drinks
DB_PASS=drinks
DB_NAME=tonight_drinks
DB_SYNC=false

REDIS_HOST=redis
REDIS_PORT=6379

# Generate once with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# Store PEM on one line with literal \n characters. Never commit a real value.
AUTH_RSA_PRIVATE_KEY=
# Generate with: openssl rand -hex 32. Never commit a real value.
AUTH_JWT_SECRET=
AUTH_REFRESH_DAYS=30
# Resend account and a verified sender domain are required for registration codes.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Tonight Drinks <no-reply@example.com>
# Admin production: true; also include https://dash.shuke.me in CORS_ORIGINS.
# Native clients remain on Bearer transport unless X-Auth-Mode: cookie is supplied.
AUTH_COOKIE_ENABLED=false
AUTH_COOKIE_SAME_SITE=strict
ADMIN_BOOTSTRAP_EMAIL=
